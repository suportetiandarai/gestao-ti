# EDGE FUNCTION: valores privados configurados com `supabase secrets set`.
# Nunca disponibilize este grupo no navegador.
GLPI_BASE_URL=https://glpi.exemplo.gov.br
GLPI_API_URL=https://glpi.exemplo.gov.br/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TECH_GROUP_NAME=Suporte TI
# ID real confirmado na instalação atual. Quando preenchido, tem prioridade sobre o nome.
GLPI_TECH_GROUP_ID=1

# Alternativa opcional ao User-Token; use somente quando formalmente autorizada.
GLPI_LOGIN=
GLPI_PASSWORD=

# Normalização, resiliência e sincronização incremental.
GLPI_TIMEZONE=America/Sao_Paulo
GLPI_TIMEZONE_OFFSET=-03:00
GLPI_REQUEST_TIMEOUT=15000
GLPI_SYNC_PAGE_SIZE=100
GLPI_SYNC_MAX_PAGES=10
GLPI_SYNC_INITIAL_MAX_PAGES=1
GLPI_SYNC_MODIFIED_AFTER=
GLPI_SLA_WARNING_MINUTES=240
GLPI_RETRY_ATTEMPTS=3
GLPI_RETRY_BASE_DELAY_MS=300
GLPI_SYNC_LOCK_SECONDS=120

# Rota pública somente leitura /dashboard-diario.
PUBLIC_DASHBOARD_ENABLED=false

# Fornecidos automaticamente pelo Supabase no runtime da Edge Function.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NAVEGADOR: não é lido deste arquivo em uma aplicação estática.
# Copie config.example.js para config.js e configure apenas valores públicos:
# SUPABASE_URL e SUPABASE_PUBLIC_KEY (publishable/anon).
